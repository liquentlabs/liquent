# Copy to .env and edit for each host.
#
# Image coordinates. Pull from registry, or `docker load` a tarball copied via scp.
LIQUENT_IMAGE=liquentlabs/liquent_node
IMAGE_TAG=latest

# Log verbosity (passed to the container as RUST_LOG).
# Examples: info, debug, liquent_node=debug,reth=info
RUST_LOG=info
